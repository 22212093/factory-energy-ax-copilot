# ─── gcp-telemetry-api 환경변수 템플릿 ──────────────────
# 실제 .env 파일을 이 기반으로 생성하세요.
# Cloud Run 배포 시에는 Secret Manager 또는 Cloud Run 환경변수로 설정.

# 서버 포트 (Cloud Run은 8080을 자동 주입)
PORT=8080

# CORS 허용 출처 — Vercel 배포 URL 또는 * (개발용)
# 예: https://factory-energy-ax-copilot.vercel.app
ALLOWED_ORIGIN=*

# 인메모리 히스토리 최대 보관 프레임 수
MAX_HISTORY=200
